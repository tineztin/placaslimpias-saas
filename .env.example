# Copia este archivo a .env.local y rellena con las claves de tu proyecto de
# Supabase (Project Settings → API). .env.local nunca se sube a git.

# Pública: segura para el navegador (protegida por Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: bypassa RLS por completo. Solo se usa en código de servidor
# (Route Handlers, Server Actions) y NUNCA debe llevar el prefijo
# NEXT_PUBLIC_ ni exponerse al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys): envía el aviso de nuevo lead a los
# notification_emails del suscriptor. Sin esta variable, el lead se sigue
# guardando con normalidad, simplemente no se manda el email.
RESEND_API_KEY=

# Upstash Redis (console.upstash.com, REST API de la base de datos): limita
# cuántos leads por minuto acepta POST /api/v1/leads, por api_key y por IP.
# Sin estas dos variables, el endpoint funciona igual, simplemente sin freno.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (dashboard.stripe.com/apikeys): checkout + portal de facturación +
# webhook que activa/desactiva subscription_status. Empieza con las claves
# de modo TEST (pk_test_.../sk_test_...) para probar sin cobrar de verdad.
STRIPE_SECRET_KEY=
# ID del precio recurrente creado en Stripe (Product catalog > tu producto).
STRIPE_PRICE_ID=
# Se obtiene al crear el endpoint de webhook en Stripe (o con `stripe listen`
# en local, ver README de la fase de Stripe).
STRIPE_WEBHOOK_SECRET=
